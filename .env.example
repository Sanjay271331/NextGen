# ============================================
# Next Gen Buildathon — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ── Application ──────────────────────────────
NODE_ENV=development
APP_NAME="Next Gen Buildathon"
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://ngb_user:ngb_dev_password@localhost:5432/next_gen_buildathon

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Session ──────────────────────────────────
SESSION_SECRET=change-this-to-a-random-64-char-string

# ── Google OAuth ─────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Google API (for Sheets/Drive/Gmail) ──────
# These are obtained via the admin dashboard's "Connect Google" flow.
# The admin authenticates and the backend stores tokens securely.
# You can also set a service-account or initial refresh token here:
GOOGLE_SERVICE_REFRESH_TOKEN=

# ── Google Sheets ────────────────────────────
# Default spreadsheet ID (per-domain sheets configured in dashboard)
GOOGLE_DEFAULT_SPREADSHEET_ID=

# ── Google Drive ─────────────────────────────
GOOGLE_DEFAULT_DRIVE_FOLDER_ID=

# ── reCAPTCHA v3 ─────────────────────────────
# Create at: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ── Initial Admin ────────────────────────────
# Email address of the first super admin (used in seed data)
INITIAL_ADMIN_EMAIL=annapparhaihole@gmail.com

# ── Encryption ───────────────────────────────
# 32-byte hex key for encrypting Google tokens at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email Defaults ───────────────────────────
DEFAULT_SENDER_NAME="Next Gen Buildathon"
DEFAULT_REPLY_TO=noreply@example.com

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REGISTRATION_RATE_LIMIT_MAX=10

# ── File Upload ──────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
