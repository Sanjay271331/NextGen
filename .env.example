# ============================================
# Next Gen Buildathon — Environment Variables Example
# ============================================

NODE_ENV=development
APP_NAME="Next Gen Buildathon"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ── Administrator Authentication ─────────────
ADMIN_PASSWORD=change-to-your-secure-admin-password

# ── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql://ngb_user:ngb_dev_password@localhost:5432/next_gen_buildathon

# ── Session ──────────────────────────────────
SESSION_SECRET=change-this-to-a-random-64-char-string

# ── Google Integration (Google Sheets API) ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_INTEGRATE_REDIRECT_URI=http://localhost:4000/api/auth/google/sheets/callback
GOOGLE_DEFAULT_SPREADSHEET_ID=

# ── Firebase Firestore (Real-Time Cloud Backup) ───
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Encryption ───────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── reCAPTCHA v3 ─────────────────────────────
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
REGISTRATION_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=5
LOG_LEVEL=info
