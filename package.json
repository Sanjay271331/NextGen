{
  "name": "next-gen-buildathon",
  "version": "1.0.0",
  "private": true,
  "description": "Next Gen Buildathon — Official Hackathon Registration & Admin Platform",
  "scripts": {
    "dev": "concurrently -n api,public -c blue,cyan \"pnpm --filter @ngb/api dev\" \"pnpm --filter @ngb/public dev\"",
    "dev:api": "pnpm --filter @ngb/api dev",
    "dev:public": "pnpm --filter @ngb/public dev",
    "build": "pnpm --filter @ngb/shared build && pnpm --filter @ngb/api build && pnpm --filter @ngb/public build",
    "build:api": "pnpm --filter @ngb/api build",
    "build:public": "pnpm --filter @ngb/public build",
    "db:generate": "pnpm --filter @ngb/api prisma:generate",
    "db:migrate": "pnpm --filter @ngb/api prisma:migrate",
    "db:studio": "pnpm --filter @ngb/api prisma:studio",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
