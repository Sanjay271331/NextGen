// ──────────────────────────────────────────────────────
// Next Gen Buildathon — Streamlined Prisma Schema (SQLite)
// ──────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Admin ─────────────────────────────────────────────

model Admin {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  role        String    @default("SUPER_ADMIN") // SUPER_ADMIN | ADMIN | VIEWER
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  googleIntegration GoogleIntegration?

  @@map("admins")
}

// ── Domains ───────────────────────────────────────────

model Domain {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  description      String?
  eventDate        DateTime?
  registrationStart DateTime?
  registrationEnd   DateTime?
  maxRegistrations Int?
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  spreadsheetId    String?
  worksheetName    String?
  formId           String?
  registrationCount Int      @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  form          Form?          @relation(fields: [formId], references: [id])
  registrations Registration[]
  sheetSyncJobs SheetSyncJob[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("domains")
}

// ── Forms ─────────────────────────────────────────────

model Form {
  id               String    @id @default(uuid())
  title            String
  description      String?
  status           String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  isGlobal         Boolean   @default(false)
  currentVersionId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  versions FormVersion[]
  domains  Domain[]

  @@index([status])
  @@map("forms")
}

model FormVersion {
  id          String    @id @default(uuid())
  formId      String
  version     Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  form          Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields        FormField[]
  registrations Registration[]

  @@unique([formId, version])
  @@map("form_versions")
}

model FormField {
  id            String  @id @default(uuid())
  formVersionId String
  type          String  // FieldType enum value: SHORT_TEXT, LONG_TEXT, EMAIL, PHONE, NUMBER, DROPDOWN, RADIO, CHECKBOX
  label         String
  name          String
  description   String?
  placeholder   String?
  required      Boolean @default(false)
  order         Int
  options       String? // JSON string: string[] for DROPDOWN, RADIO, CHECKBOX
  validation    String? // JSON string: FieldValidation object

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  @@index([formVersionId, order])
  @@map("form_fields")
}

// ── Registrations (Primary Source of Truth) ────────────

model Registration {
  id             String    @id @default(uuid())
  registrationId String    @unique // Human-readable: NGB-YYMMDD-NNNNN
  domainId       String
  formVersionId  String
  teamName       String?
  teamLeaderName String?
  email          String
  phone          String?
  status         String    @default("REGISTERED") // RegistrationStatus
  syncStatus     String    @default("PENDING_SYNC") // SyncStatus: PENDING_SYNC, SYNCED, SYNC_FAILED
  syncedAt       DateTime?
  values         String    @default("{}") // JSON string: All form responses
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  domain        Domain         @relation(fields: [domainId], references: [id])
  formVersion   FormVersion    @relation(fields: [formVersionId], references: [id])
  sheetSyncJobs SheetSyncJob[]

  @@unique([domainId, email, deletedAt])
  @@index([domainId])
  @@index([email])
  @@index([teamName])
  @@index([status])
  @@index([syncStatus])
  @@index([registrationId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("registrations")
}

// ── Google Integration (Sheets Storage Only) ──────────

model GoogleIntegration {
  id              String    @id @default(uuid())
  adminId         String    @unique
  email           String
  accessToken     String
  refreshToken    String
  tokenExpiry     DateTime
  scopes          String    @default("[]") // JSON string
  isActive        Boolean   @default(true)
  sheetsConnected Boolean   @default(true)
  spreadsheetId   String?
  lastTestedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("google_integrations")
}

// ── Sheet Sync Jobs ───────────────────────────────────

model SheetSyncJob {
  id             String    @id @default(uuid())
  registrationId String
  domainId       String
  spreadsheetId  String
  worksheetName  String
  status         String    @default("PENDING_SYNC") // SyncStatus
  retryCount     Int       @default(0)
  error          String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([registrationId])
  @@map("sheet_sync_jobs")
}

// ── System Settings ───────────────────────────────────

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @default("{}") // JSON string
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
